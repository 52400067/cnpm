{
  "name": "tickethub-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @tickethub/api dev",
    "dev:all": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @tickethub/api db:generate",
    "db:migrate": "pnpm --filter @tickethub/api db:migrate",
    "db:seed": "pnpm --filter @tickethub/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
